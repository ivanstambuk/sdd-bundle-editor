{
  "$id": "sdd-bundle:jwt-validator:ConformanceSuite",
  "type": "object",
  "title": "ConformanceSuite",
  "required": [
    "id",
    "kind",
    "title"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^SUITE-[a-zA-Z0-9-]+$",
      "x-sdd-displayHint": "hidden",
      "x-sdd-layoutGroup": "overview"
    },
    "kind": {
      "type": "string",
      "const": "ConformanceSuite",
      "x-sdd-displayHint": "hidden",
      "x-sdd-layoutGroup": "overview"
    },
    "title": {
      "type": "string",
      "x-sdd-layoutGroup": "overview",
      "x-sdd-order": 10
    },
    "description": {
      "type": "string",
      "x-sdd-displayHint": "markdown",
      "x-sdd-layoutGroup": "overview",
      "x-sdd-prominence": "primary",
      "x-sdd-prominenceLabel": "Description",
      "x-sdd-prominenceIcon": "📝",
      "x-sdd-order": 20
    },
    "rationale": {
      "type": "string",
      "x-sdd-displayHint": "markdown",
      "x-sdd-layoutGroup": "overview",
      "x-sdd-prominence": "secondary",
      "x-sdd-prominenceLabel": "Rationale",
      "x-sdd-prominenceIcon": "🤔",
      "x-sdd-order": 30
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "x-sdd-displayHint": "chips",
      "x-sdd-layoutGroup": "overview",
      "x-sdd-order": 99
    },
    "executionStatus": {
      "type": "string",
      "title": "Execution Status",
      "description": "Whether this artifact is part of the active executable contract, advisory-only, or planned for later execution.",
      "enum": [
        "active",
        "advisory",
        "planned"
      ],
      "x-sdd-layoutGroup": "details",
      "x-sdd-order": 1
    },
    "artifactClass": {
      "type": "string",
      "title": "Artifact Class",
      "description": "Classifies whether this entity is part of the contract, a support artifact, fixture infrastructure, or documentation.",
      "enum": [
        "contract",
        "support",
        "fixture",
        "documentation"
      ],
      "x-sdd-layoutGroup": "details",
      "x-sdd-order": 2
    },
    "lifecycleStatus": {
      "type": "string",
      "title": "Lifecycle Status",
      "description": "Tracks whether this artifact is still draft, active, deprecated, or superseded.",
      "enum": [
        "draft",
        "active",
        "deprecated",
        "superseded"
      ],
      "x-sdd-layoutGroup": "details",
      "x-sdd-order": 3
    },
    "governedByAdrIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "x-sdd-refTargets": [
        "ADR"
      ],
      "x-sdd-layoutGroup": "traceability",
      "x-sdd-order": 10,
      "title": "Governed By Adr References",
      "description": "References related ADR entity."
    },
    "targetsClassIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "x-sdd-refTargets": [
        "ConformanceClass"
      ],
      "x-sdd-layoutGroup": "traceability",
      "x-sdd-order": 20,
      "title": "Targets Class References",
      "description": "References related ConformanceClass entity."
    },
    "containsVectorIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "x-sdd-refTargets": [
        "TestVector"
      ],
      "x-sdd-layoutGroup": "traceability",
      "x-sdd-order": 30,
      "title": "Contains Vector References",
      "description": "References related TestVector entity."
    },
    "requiresFixtureIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "x-sdd-refTargets": [
        "MockKeySet"
      ],
      "x-sdd-layoutGroup": "traceability",
      "x-sdd-order": 35,
      "title": "Requires Fixture References",
      "description": "References mock-key fixtures required to execute this suite."
    },
    "requiresEnvironmentCapabilities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "x-sdd-layoutGroup": "details",
      "x-sdd-order": 15
    },
    "ownedByActorId": {
      "type": "string",
      "x-sdd-refTargets": [
        "Actor"
      ],
      "x-sdd-layoutGroup": "traceability",
      "x-sdd-order": 40,
      "format": "sdd-ref",
      "title": "Owned By Actor Reference",
      "description": "References related Actor entity."
    }
  },
  "x-sdd-ui": {
    "displayName": "Conformance Suite",
    "displayNamePlural": "Conformance Suites",
    "icon": "🧪"
  },
  "x-sdd-layoutGroups": {
    "overview": {
      "title": "Overview",
      "order": 1
    },
    "details": {
      "title": "Properties & Configuration",
      "order": 2
    },
    "traceability": {
      "title": "Relationships",
      "order": 3
    }
  }
}
