{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ConceptFamily",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "theme"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^CCFAM-[a-z0-9-]+$",
      "x-sdd-entityType": "ConceptFamily",
      "x-sdd-idTemplate": "CCFAM-{slug}"
    },
    "title": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "theme": {
      "type": "string"
    },
    "summary": {
      "type": "string",
      "x-sdd-displayHint": "markdown"
    },
    "businessRuleIds": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "sdd-ref",
        "x-sdd-refTargets": [
          "BusinessRule"
        ]
      },
      "x-sdd-displayHint": "chips"
    },
    "domainCapabilityIds": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "sdd-ref",
        "x-sdd-refTargets": [
          "DomainCapability"
        ]
      },
      "x-sdd-displayHint": "chips"
    },
    "processFlowIds": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "sdd-ref",
        "x-sdd-refTargets": [
          "ProcessFlow"
        ]
      },
      "x-sdd-displayHint": "chips"
    },
    "participantIds": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "sdd-ref",
        "x-sdd-refTargets": [
          "Participant"
        ]
      },
      "x-sdd-displayHint": "chips"
    },
    "domainResourceIds": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "sdd-ref",
        "x-sdd-refTargets": [
          "DomainResource"
        ]
      },
      "x-sdd-displayHint": "chips"
    },
    "valueObjectIds": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "sdd-ref",
        "x-sdd-refTargets": [
          "ValueObject"
        ]
      },
      "x-sdd-displayHint": "chips"
    },
    "statusTransitionIds": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "sdd-ref",
        "x-sdd-refTargets": [
          "StatusTransition"
        ]
      },
      "x-sdd-displayHint": "chips"
    },
    "sourceServiceIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "x-sdd-displayHint": "chips"
    },
    "sourceBootstrapConceptFamilyId": {
      "type": "string"
    },
    "notes": {
      "type": "string",
      "x-sdd-displayHint": "markdown"
    }
  }
}
