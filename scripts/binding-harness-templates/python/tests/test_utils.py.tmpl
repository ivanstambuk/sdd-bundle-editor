from __future__ import annotations

import base64
import hashlib
import hmac
import json
from typing import Any

import jwt
from cryptography.hazmat.primitives import hashes, serialization
from cryptography.hazmat.primitives.asymmetric import padding, rsa

from .fixtures.keysets import FIXTURES

_DERIVED_WEAK_RSA_FIXTURE: dict[str, Any] | None = None


def _clone(value: Any) -> Any:
    return json.loads(json.dumps(value))


def _default_fixture_id_for_vector(vector: dict[str, Any]) -> str:
    return vector.get("usesMockKeyId") or "MOCK-hs256-static-1"


def _resolve_fixture_key(vector: dict[str, Any]) -> dict[str, Any]:
    fixture = FIXTURES.get(_default_fixture_id_for_vector(vector))
    keys = (((fixture or {}).get("jwks") or {}).get("keys") or [])
    if not keys:
        raise RuntimeError(f"No JWKS fixture available for {vector.get('id')}")

    requested_header = json.loads(vector["headerJson"]) if vector.get("headerJson") else {}
    requested_alg = requested_header.get("alg")
    requested_kid = requested_header.get("kid")

    if requested_kid:
        for candidate in keys:
            if isinstance(candidate, dict) and candidate.get("kid") == requested_kid:
                return _clone(candidate)

    if requested_alg:
        for candidate in keys:
            if isinstance(candidate, dict) and candidate.get("alg") == requested_alg:
                return _clone(candidate)

    return _clone(keys[0])


def _b64url_uint(value: int) -> str:
    byte_length = max(1, (value.bit_length() + 7) // 8)
    return base64.urlsafe_b64encode(value.to_bytes(byte_length, "big")).rstrip(b"=").decode("ascii")


def _get_derived_weak_rsa_fixture() -> dict[str, Any]:
    global _DERIVED_WEAK_RSA_FIXTURE
    if _DERIVED_WEAK_RSA_FIXTURE is None:
        private_key = rsa.generate_private_key(public_exponent=65537, key_size=1024)
        public_numbers = private_key.public_key().public_numbers()
        _DERIVED_WEAK_RSA_FIXTURE = {
            "publicJwk": {
                "kty": "RSA",
                "kid": "rsa-weak-1",
                "alg": "RS256",
                "use": "sig",
                "n": _b64url_uint(public_numbers.n),
                "e": _b64url_uint(public_numbers.e),
            },
            "privateKey": private_key,
        }
    return _DERIVED_WEAK_RSA_FIXTURE


def _infer_base_payload(vector: dict[str, Any]) -> dict[str, Any]:
    runtime_policy = vector.get("runtimePolicy") or {}
    overlay = json.loads(vector["payloadJson"]) if vector.get("payloadJson") else None

    def omits_required_claim(claim_name: str, policy_value: Any) -> bool:
        return (
            vector.get("expectedFailedRuleId") == "RULE-REQUIRED-CLAIMS"
            and policy_value is not None
            and (not overlay or claim_name not in overlay)
        )

    payload: dict[str, Any] = {
        "iat": 1516239022,
        "exp": 2500000000,
    }

    if not omits_required_claim("sub", runtime_policy.get("expectedSubject")):
        payload["sub"] = "1234567890"

    if isinstance(runtime_policy.get("expectedIssuer"), str) and not omits_required_claim("iss", runtime_policy.get("expectedIssuer")):
        payload["iss"] = runtime_policy["expectedIssuer"]

    if isinstance(runtime_policy.get("expectedSubject"), str) and not omits_required_claim("sub", runtime_policy.get("expectedSubject")):
        payload["sub"] = runtime_policy["expectedSubject"]

    expected_audience = runtime_policy.get("expectedAudience")
    if isinstance(expected_audience, str) and not omits_required_claim("aud", expected_audience):
        payload["aud"] = expected_audience
    if isinstance(expected_audience, list) and not omits_required_claim("aud", expected_audience):
        payload["aud"] = expected_audience

    return payload


def _infer_base_header(vector: dict[str, Any], key: dict[str, Any]) -> dict[str, Any]:
    alg = key.get("alg")
    if not isinstance(alg, str):
        alg = "RS256" if key.get("kty") == "RSA" else "HS256"

    header: dict[str, Any] = {
        "alg": alg,
        "typ": "JWT",
    }
    if isinstance(key.get("kid"), str):
        header["kid"] = key["kid"]
    return header


def _merge_payload(vector: dict[str, Any]) -> dict[str, Any]:
    payload = _infer_base_payload(vector)
    if not vector.get("payloadJson"):
        return payload
    payload.update(json.loads(vector["payloadJson"]))
    return payload


def _merge_header(vector: dict[str, Any], key: dict[str, Any]) -> dict[str, Any]:
    header = _infer_base_header(vector, key)
    if not vector.get("headerJson"):
        return header
    header.update(json.loads(vector["headerJson"]))
    return header


def _encode_json_segment(json_text: str) -> str:
    return base64.urlsafe_b64encode(json_text.encode("utf-8")).rstrip(b"=").decode("ascii")


def _base64url_decode(secret_text: str) -> bytes:
    padding_len = (-len(secret_text)) % 4
    return base64.urlsafe_b64decode(secret_text + ("=" * padding_len))


def _sign_hs256_raw_compact(header: dict[str, Any], payload_json_text: str, secret_b64url: str) -> str:
    encoded_header = _encode_json_segment(json.dumps(header, separators=(",", ":")))
    encoded_payload = _encode_json_segment(payload_json_text)
    signing_input = f"{encoded_header}.{encoded_payload}"
    secret = _base64url_decode(secret_b64url)
    signature = hmac.new(secret, signing_input.encode("ascii"), hashlib.sha256).digest()
    encoded_signature = base64.urlsafe_b64encode(signature).rstrip(b"=").decode("ascii")
    return f"{signing_input}.{encoded_signature}"


def _sign_rs256_raw_compact(header: dict[str, Any], payload_json_text: str, private_key: rsa.RSAPrivateKey) -> str:
    encoded_header = _encode_json_segment(json.dumps(header, separators=(",", ":")))
    encoded_payload = _encode_json_segment(payload_json_text)
    signing_input = f"{encoded_header}.{encoded_payload}"
    signature = private_key.sign(
        signing_input.encode("ascii"),
        padding.PKCS1v15(),
        hashes.SHA256(),
    )
    encoded_signature = base64.urlsafe_b64encode(signature).rstrip(b"=").decode("ascii")
    return f"{signing_input}.{encoded_signature}"


def _sign_structured_token(payload: dict[str, Any], header: dict[str, Any], key: dict[str, Any]) -> str:
    kty = key.get("kty")
    if kty == "oct":
        secret = _base64url_decode(str(key["k"]))
        return jwt.encode(payload, secret, algorithm=str(header.get("alg", "HS256")), headers=header)

    raise RuntimeError(f"Fixture key for {header.get('kid', 'unknown-kid')} is not signable in the Python frozen test pack")


def resolve_trusted_jwks(vector: dict[str, Any]) -> dict[str, Any]:
    if vector.get("id") == "VEC-jwt-weak-key":
        weak_fixture = _get_derived_weak_rsa_fixture()
        return {"keys": [_clone(weak_fixture["publicJwk"])]}

    fixture = FIXTURES.get(_default_fixture_id_for_vector(vector))
    keys = (((fixture or {}).get("jwks") or {}).get("keys") or [])
    if not keys:
        return {"keys": []}
    return _clone((fixture or {}).get("jwks"))


def prepare_token(vector: dict[str, Any]) -> str:
    raw_jwt = vector.get("rawJwtInput")
    if isinstance(raw_jwt, str) and raw_jwt:
        return raw_jwt

    if vector.get("id") == "VEC-jwt-malformed":
        return "not.a.jwt"

    key = _resolve_fixture_key(vector)
    header = _merge_header(vector, key)
    payload = _merge_payload(vector)

    if vector.get("id") in {"VEC-jwt-duplicate-keys", "VEC-jwt-unsupported-header-crit"} and isinstance(key.get("k"), str):
        payload_json_text = vector["payloadJson"] if vector.get("id") == "VEC-jwt-duplicate-keys" and isinstance(vector.get("payloadJson"), str) else json.dumps(payload, separators=(",", ":"))
        return _sign_hs256_raw_compact(header, payload_json_text, key["k"])

    if vector.get("id") == "VEC-jwt-weak-key":
        weak_fixture = _get_derived_weak_rsa_fixture()
        weak_header = dict(header)
        weak_header["alg"] = "RS256"
        weak_header["kid"] = "rsa-weak-1"
        return _sign_rs256_raw_compact(weak_header, json.dumps(payload, separators=(",", ":")), weak_fixture["privateKey"])

    return _sign_structured_token(payload, header, key)
