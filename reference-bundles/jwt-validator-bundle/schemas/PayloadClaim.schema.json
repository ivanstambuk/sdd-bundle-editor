    "id",
    "kind",
    "title"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^CLAIM-[a-z0-9-]+$",
      "x-sdd-displayHint": "hidden",
      "x-sdd-layoutGroup": "overview"
    },
    "kind": {
      "type": "string",
      "const": "PayloadClaim",
      "x-sdd-displayHint": "hidden",
      "x-sdd-layoutGroup": "overview"
    },
    "title": {
      "type": "string",
      "x-sdd-layoutGroup": "overview",
      "x-sdd-order": 10
    },
    "description": {
      "type": "string",
      "x-sdd-displayHint": "markdown",
      "x-sdd-layoutGroup": "overview",
      "x-sdd-prominence": "primary",
      "x-sdd-prominenceLabel": "Description",
      "x-sdd-prominenceIcon": "📝",
      "x-sdd-order": 20
    },
    "rationale": {
      "type": "string",
      "x-sdd-displayHint": "markdown",
      "x-sdd-layoutGroup": "overview",
      "x-sdd-prominence": "secondary",
      "x-sdd-prominenceLabel": "Rationale",
      "x-sdd-prominenceIcon": "🤔",
      "x-sdd-order": 30
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "x-sdd-displayHint": "chips",
      "x-sdd-layoutGroup": "overview",
      "x-sdd-order": 99
    },
    "governedByAdrIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "x-sdd-refTargets": [
        "ADR"
      ],
      "x-sdd-layoutGroup": "traceability",
      "x-sdd-order": 10
    },
    "name": {
      "type": "string",
      "x-sdd-layoutGroup": "details",
      "x-sdd-order": 10
    },
    "dataType": {
      "type": "string",
      "enum": [
        "string",
        "number",
        "boolean",
        "array",
        "object"
      ],
      "x-sdd-layoutGroup": "details",
      "x-sdd-order": 20
    },
    "isRequired": {
      "type": "boolean",
      "x-sdd-layoutGroup": "details",
      "x-sdd-order": 30
    },
    "isStandardRFC": {
      "type": "boolean",
      "x-sdd-layoutGroup": "details",
      "x-sdd-order": 40
    },
    "definesNestedStructureId": {
      "type": "string",
      "x-sdd-refTargets": [
        "DataStructure"
      ],
      "x-sdd-layoutGroup": "traceability",
      "x-sdd-order": 20
    },
    "constrainedByRuleIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "x-sdd-refTargets": [
        "ValidationRule"
      ],
      "x-sdd-layoutGroup": "traceability",
      "x-sdd-order": 30
    }
  },
  "x-sdd-ui": {
    "displayName": "Payload Claim",
    "displayNamePlural": "Payload Claims",
    "icon": "📦"
