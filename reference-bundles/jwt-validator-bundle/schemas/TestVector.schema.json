{
  "$id": "sdd-bundle:jwt-validator:TestVector",
  "type": "object",
  "title": "TestVector",
  "required": [
    "id",
    "kind",
    "title"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^VEC-[a-z0-9-]+$",
      "x-sdd-displayHint": "hidden",
      "x-sdd-layoutGroup": "overview"
    },
    "kind": {
      "type": "string",
      "const": "TestVector",
      "x-sdd-displayHint": "hidden",
      "x-sdd-layoutGroup": "overview"
    },
    "title": {
      "type": "string",
      "x-sdd-layoutGroup": "overview",
      "x-sdd-order": 10
    },
    "description": {
      "type": "string",
      "x-sdd-displayHint": "markdown",
      "x-sdd-layoutGroup": "overview",
      "x-sdd-prominence": "primary",
      "x-sdd-prominenceLabel": "Description",
      "x-sdd-prominenceIcon": "📝",
      "x-sdd-order": 20
    },
    "rationale": {
      "type": "string",
      "x-sdd-displayHint": "markdown",
      "x-sdd-layoutGroup": "overview",
      "x-sdd-prominence": "secondary",
      "x-sdd-prominenceLabel": "Rationale",
      "x-sdd-prominenceIcon": "🤔",
      "x-sdd-order": 30
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "x-sdd-displayHint": "chips",
      "x-sdd-layoutGroup": "overview",
      "x-sdd-order": 99
    },
    "executionStatus": {
      "type": "string",
      "title": "Execution Status",
      "description": "Whether this artifact is part of the active executable contract, advisory-only, or planned for later execution.",
      "enum": [
        "active",
        "advisory",
        "planned"
      ],
      "x-sdd-layoutGroup": "details",
      "x-sdd-order": 1
    },
    "artifactClass": {
      "type": "string",
      "title": "Artifact Class",
      "description": "Classifies whether this entity is part of the contract, a support artifact, fixture infrastructure, or documentation.",
      "enum": [
        "contract",
        "support",
        "fixture",
        "documentation"
      ],
      "x-sdd-layoutGroup": "details",
      "x-sdd-order": 2
    },
    "lifecycleStatus": {
      "type": "string",
      "title": "Lifecycle Status",
      "description": "Tracks whether this artifact is still draft, active, deprecated, or superseded.",
      "enum": [
        "draft",
        "active",
        "deprecated",
        "superseded"
      ],
      "x-sdd-layoutGroup": "details",
      "x-sdd-order": 3
    },
    "governedByAdrIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "x-sdd-refTargets": [
        "ADR"
      ],
      "x-sdd-layoutGroup": "traceability",
      "x-sdd-order": 10,
      "title": "Governed By Adr References",
      "description": "References related ADR entity."
    },
    "implementationHints": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Advisory implementation-time hints for generators. Do not use this field as the sole source of normative behavior; encode contract semantics in first-class fields and relationships.",
      "x-sdd-layoutGroup": "details",
      "x-sdd-order": 10
    },
    "rawJwtInput": {
      "type": "string",
      "description": "Authoritative raw token input for operations that consume a JWT string directly.",
      "x-sdd-layoutGroup": "details",
      "x-sdd-order": 11
    },
    "headerJson": {
      "type": "string",
      "x-sdd-layoutGroup": "details",
      "x-sdd-order": 12,
      "x-sdd-displayHint": "multiline"
    },
    "runtimePolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "expectedIssuer": {
          "type": "string"
        },
        "expectedSubject": {
          "type": "string"
        },
        "expectedAudience": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            }
          ]
        },
        "expectedTyp": {
          "type": "string"
        },
        "allowedClockSkewSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "allowDiagnosticClaimsOnFailure": {
          "type": "boolean"
        },
        "allowTrustSensitiveHeaderSources": {
          "type": "boolean"
        },
        "allowedCriticalHeaders": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "allowedClockSkewSeconds"
      ],
      "description": "Authoritative runtime policy values that the generated implementation or tests must pass into the operation under test.",
      "x-sdd-layoutGroup": "details",
      "x-sdd-order": 20
    },
    "validationContext": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "currentTimeEpochSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "selectedKeyStrategyId": {
          "type": "string"
        },
        "trustedJwks": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "keys": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": true,
                "properties": {
                  "kty": {
                    "type": "string"
                  },
                  "kid": {
                    "type": "string"
                  },
                  "alg": {
                    "type": "string"
                  }
                },
                "required": [
                  "kty"
                ]
              }
            }
          }
        },
        "tenantId": {
          "type": "string"
        },
        "replayStateMode": {
          "type": "string",
          "enum": [
            "out-of-scope",
            "unchecked",
            "checked"
          ]
        },
        "invocationSource": {
          "type": "string",
          "enum": [
            "runtime",
            "diagnostic",
            "conformance"
          ]
        }
      },
      "required": [
        "currentTimeEpochSeconds",
        "invocationSource"
      ],
      "description": "Authoritative invocation context for a validation run, including current time and key material when applicable.",
      "x-sdd-layoutGroup": "details",
      "x-sdd-order": 21
    },
    "invocationProfileId": {
      "type": "string",
      "x-sdd-refTargets": [
        "TokenProfile"
      ],
      "x-sdd-layoutGroup": "traceability",
      "x-sdd-order": 22,
      "format": "sdd-ref",
      "title": "Invocation Profile Reference",
      "description": "References related TokenProfile entity."
    },
    "invokesOperationId": {
      "type": "string",
      "x-sdd-refTargets": [
        "Operation"
      ],
      "x-sdd-layoutGroup": "traceability",
      "x-sdd-order": 23,
      "format": "sdd-ref",
      "title": "Invokes Operation Reference",
      "description": "References the operation exercised by this vector."
    },
    "validatesRuleIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "x-sdd-refTargets": [
        "ValidationRule"
      ],
      "x-sdd-layoutGroup": "traceability",
      "x-sdd-order": 20,
      "title": "Validates Rule References",
      "description": "References related ValidationRule entity."
    },
    "expectsErrorCodeIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "x-sdd-refTargets": [
        "ErrorCode"
      ],
      "x-sdd-layoutGroup": "traceability",
      "x-sdd-order": 30,
      "title": "Expects Error Code References",
      "description": "References related ErrorCode entity."
    },
    "expectedPrimaryErrorCodeId": {
      "type": "string",
      "x-sdd-refTargets": [
        "ErrorCode"
      ],
      "x-sdd-layoutGroup": "traceability",
      "x-sdd-order": 32,
      "format": "sdd-ref",
      "title": "Expected Primary Error Code Reference",
      "description": "Normative primary error that should be surfaced for this vector when one is expected."
    },
    "expectedOutcomeClass": {
      "type": "string",
      "enum": [
        "accepted",
        "rejected",
        "malformed",
        "indeterminate",
        "diagnostic"
      ],
      "description": "Normative terminal outcome classification for this vector.",
      "x-sdd-layoutGroup": "details",
      "x-sdd-order": 25
    },
    "expectedKeySelectionStatus": {
      "type": "string",
      "enum": [
        "not-applicable",
        "resolved",
        "missing",
        "ambiguous"
      ],
      "description": "Normative key-selection status expected from the public result for this vector when applicable.",
      "x-sdd-layoutGroup": "details",
      "x-sdd-order": 26
    },
    "expectedTrustDecision": {
      "type": "string",
      "enum": [
        "trusted",
        "rejected",
        "indeterminate"
      ],
      "description": "Normative trust decision expected from the public result for this vector when applicable.",
      "x-sdd-layoutGroup": "details",
      "x-sdd-order": 27
    },
    "expectedEvaluatedProfileId": {
      "type": "string",
      "x-sdd-refTargets": [
        "TokenProfile"
      ],
      "x-sdd-layoutGroup": "traceability",
      "x-sdd-order": 35,
      "format": "sdd-ref",
      "title": "Expected Evaluated Profile Reference",
      "description": "Normative evaluated profile expected from the public result for this vector when one should be reported."
    },
    "expectedFailedRuleId": {
      "type": "string",
      "x-sdd-refTargets": [
        "ValidationRule"
      ],
      "x-sdd-layoutGroup": "traceability",
      "x-sdd-order": 36,
      "format": "sdd-ref",
      "title": "Expected Failed Rule Reference",
      "description": "Normative failed rule expected from the public result for this vector when one should be reported."
    },
    "expectedTerminalStepId": {
      "type": "string",
      "x-sdd-refTargets": [
        "ValidationStep"
      ],
      "x-sdd-layoutGroup": "traceability",
      "x-sdd-order": 37,
      "format": "sdd-ref",
      "title": "Expected Terminal Step Reference",
      "description": "Normative terminal validation step expected for this vector when the execution model exposes it."
    },
    "usesMockKeyId": {
      "type": "string",
      "x-sdd-refTargets": [
        "MockKeySet"
      ],
      "x-sdd-layoutGroup": "traceability",
      "x-sdd-order": 40,
      "format": "sdd-ref",
      "title": "Uses Mock Key Reference",
      "description": "References related MockKeySet entity."
    },
    "requiresFixtureIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "x-sdd-refTargets": [
        "MockKeySet"
      ],
      "x-sdd-layoutGroup": "traceability",
      "x-sdd-order": 41,
      "title": "Requires Fixture References",
      "description": "References mock-key or remote-key fixtures required to execute this vector."
    },
    "remoteResolutionScenario": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cacheState": {
          "type": "string",
          "enum": [
            "cold-start",
            "warm-cache",
            "stale-cache"
          ]
        },
        "refreshTrigger": {
          "type": "string",
          "enum": [
            "none",
            "initial-fetch",
            "kid-miss",
            "key-rollover",
            "network-retry"
          ]
        },
        "expectedFetchBehavior": {
          "type": "string",
          "enum": [
            "not-reached",
            "cache-only",
            "fetch-success",
            "refresh-success",
            "fail-closed-after-retry"
          ]
        }
      },
      "required": [
        "cacheState",
        "refreshTrigger",
        "expectedFetchBehavior"
      ],
      "x-sdd-layoutGroup": "details",
      "x-sdd-order": 24
    },
    "oidcDiscoveryScenario": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "metadataState": {
          "type": "string",
          "enum": [
            "initial-discovery",
            "cached-discovery",
            "metadata-refresh"
          ]
        },
        "issuerBindingOutcome": {
          "type": "string",
          "enum": [
            "match",
            "mismatch"
          ]
        },
        "jwksUriOutcome": {
          "type": "string",
          "enum": [
            "match",
            "mismatch",
            "drift"
          ]
        },
        "expectedDiscoveryBehavior": {
          "type": "string",
          "enum": [
            "fetch-success",
            "cache-only",
            "refresh-success",
            "fail-closed"
          ]
        }
      },
      "required": [
        "metadataState",
        "issuerBindingOutcome",
        "jwksUriOutcome",
        "expectedDiscoveryBehavior"
      ],
      "x-sdd-layoutGroup": "details",
      "x-sdd-order": 25
    },
    "payloadJson": {
      "type": "string",
      "x-sdd-layoutGroup": "details",
      "x-sdd-order": 15,
      "x-sdd-displayHint": "multiline"
    }
