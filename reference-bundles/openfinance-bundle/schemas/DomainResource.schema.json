{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DomainResource",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "resourceName",
    "kind"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^RES-[a-z0-9-]+$",
      "x-sdd-entityType": "DomainResource",
      "x-sdd-idTemplate": "RES-{slug}"
    },
    "title": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "resourceName": {
      "type": "string"
    },
    "kind": {
      "type": "string"
    },
    "parentResourceId": {
      "type": "string",
      "format": "sdd-ref",
      "x-sdd-refTargets": [
        "DomainResource"
      ]
    },
    "conceptFamilyId": {
      "type": "string",
      "format": "sdd-ref",
      "x-sdd-refTargets": [
        "ConceptFamily"
      ]
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "x-sdd-displayHint": "chips"
    },
    "participantIds": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "sdd-ref",
        "x-sdd-refTargets": [
          "Participant"
        ]
      },
      "x-sdd-displayHint": "chips"
    },
    "sourceServiceIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "x-sdd-displayHint": "chips"
    },
    "normativeCitationIds": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "sdd-ref",
        "x-sdd-refTargets": [
          "NormativeCitation"
        ]
      },
      "x-sdd-displayHint": "chips"
    },
    "technicalCitationIds": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "sdd-ref",
        "x-sdd-refTargets": [
          "TechnicalCitation"
        ]
      },
      "x-sdd-displayHint": "chips"
    },
    "sourceBootstrapResourceId": {
      "type": "string"
    },
    "notes": {
      "type": "string",
      "x-sdd-displayHint": "markdown"
    }
  }
}
