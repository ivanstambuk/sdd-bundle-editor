                  "required": [
                    "headerJson"
                  ]
                },
                {
                  "properties": {
                    "payloadJson": {}
                  },
                  "required": [
                    "payloadJson"
                  ]
                }
              ]
            }
          },
          {
            "anyOf": [
              {
                "properties": {
                  "headerJson": {}
