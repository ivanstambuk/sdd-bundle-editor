{
  "$id": "https://example.com/sdd/Protocol.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Protocol",
  "description": "API or communication protocol specification - interaction/communication contract",
  "type": "object",
  "required": [
    "createdDate",
    "id",
    "kind",
    "lastModifiedBy",
    "lastModifiedDate",
    "title",
    "version"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^PROTO-[a-z0-9-]+$",
      "x-sdd-idTemplate": "PROTO-{000}",
      "x-sdd-entityType": "Protocol",
      "x-sdd-idScope": "bundle",
      "description": "Unique identifier for this entity",
      "maxLength": 30,
      "x-sdd-layoutGroup": "overview",
      "x-sdd-displayHint": "hidden"
    },
    "title": {
      "type": "string",
      "minLength": 5,
      "description": "Short, descriptive name",
      "maxLength": 80,
      "x-sdd-layoutGroup": "overview",
      "x-sdd-order": 10
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "Semantic version of the protocol",
      "x-sdd-layoutGroup": "overview",
      "x-sdd-order": 20
    },
    "kind": {
      "type": "string",
      "enum": [
        "http-rest",
        "graphql",
        "grpc",
        "messaging",
        "cli",
        "websocket",
        "file",
        "custom"
      ],
      "description": "Protocol type (aligned with vision.md meta-model)",
      "x-sdd-enumTitles": {
        "http-rest": "HTTP REST",
        "graphql": "GraphQL",
        "grpc": "gRPC",
        "messaging": "Messaging",
        "cli": "CLI",
        "websocket": "Websocket",
        "file": "File",
        "custom": "Custom"
      },
      "x-sdd-layoutGroup": "overview",
      "x-sdd-order": 25
    },
    "role": {
      "type": "string",
      "enum": [
        "provider",
        "consumer",
        "both"
      ],
      "description": "Whether this bundle provides, consumes, or both for this protocol",
      "x-sdd-enumTitles": {
        "provider": "Provider",
        "consumer": "Consumer",
        "both": "Both"
      },
      "x-sdd-layoutGroup": "overview",
      "x-sdd-order": 30
    },
    "description": {
      "type": "string",
      "x-sdd-widget": "textarea",
      "description": "Detailed explanation of purpose and behavior",
      "x-sdd-displayHint": "markdown",
      "x-sdd-layoutGroup": "overview",
      "x-sdd-prominence": "secondary",
      "x-sdd-prominenceLabel": "Description",
      "x-sdd-prominenceIcon": "🔌",
      "x-sdd-order": 40
    },
    "summary": {
      "type": "string",
      "description": "Brief summary of the protocol purpose",
      "x-sdd-displayHint": "markdown",
      "x-sdd-layoutGroup": "overview",
      "x-sdd-prominence": "secondary",
      "x-sdd-prominenceLabel": "Summary",
      "x-sdd-prominenceIcon": "📝",
      "x-sdd-order": 35
    },
    "transport": {
      "type": "string",
      "enum": [
        "http",
        "https",
        "websocket",
        "grpc",
        "mqtt",
        "custom"
      ],
      "description": "Transport layer used by the protocol",
      "x-sdd-enumTitles": {
        "http": "Http",
        "https": "Https",
        "websocket": "Websocket",
        "grpc": "gRPC",
        "mqtt": "Mqtt",
        "custom": "Custom"
      },
      "x-sdd-layoutGroup": "technical",
      "x-sdd-order": 10
    },
    "authentication": {
      "type": "string",
      "enum": [
        "none",
        "api-key",
        "bearer-token",
        "oauth2",
        "mTLS",
        "custom"
      ],
      "description": "Authentication mechanism",
      "x-sdd-enumTitles": {
        "none": "None",
        "api-key": "API Key",
        "bearer-token": "Bearer Token",
        "oauth2": "OAuth2",
        "mTLS": "mTLS",
        "custom": "Custom"
      },
      "x-sdd-layoutGroup": "technical",
      "x-sdd-order": 20
    },
    "securityModel": {
      "type": "string",
      "description": "Security model (e.g., oauth2-authorization-code, mtls, enterprise-token)",
      "x-sdd-layoutGroup": "technical",
      "x-sdd-order": 30
    },
    "endpoints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "method"
        ],
        "properties": {
          "path": {
            "type": "string",
            "description": "Endpoint path (e.g., /api/v1/users)"
          },
          "method": {
            "type": "string",
            "enum": [
              "GET",
              "POST",
              "PUT",
              "PATCH",
              "DELETE",
              "HEAD",
              "OPTIONS"
            ]
          },
          "description": {
            "type": "string"
          },
          "requestSchemaId": {
            "type": "string",
            "format": "sdd-ref",
            "x-sdd-refTargets": [
              "DataSchema"
            ],
            "description": "Reference to request body DataSchema"
          },
          "responseSchemaId": {
            "type": "string",
            "format": "sdd-ref",
            "x-sdd-refTargets": [
              "DataSchema"
            ],
            "description": "Reference to response body DataSchema"
          }
        }
      },
      "description": "API endpoint definitions",
      "x-sdd-layoutGroup": "endpoints",
      "x-sdd-order": 10
    },
    "providedByComponents": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "sdd-ref",
        "x-sdd-refTargets": [
          "Component"
        ]
      },
      "uniqueItems": true,
      "description": "Components that provide this protocol",
      "title": "provided by",
      "x-sdd-layoutGroup": "traceability",
      "x-sdd-order": 10
    },
    "consumedByComponents": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "sdd-ref",
        "x-sdd-refTargets": [
          "Component"
        ]
      },
      "uniqueItems": true,
      "description": "Components that consume this protocol",
      "title": "consumed by",
      "x-sdd-layoutGroup": "traceability",
      "x-sdd-order": 20
    },
    "nfrBindings": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "sdd-ref",
        "x-sdd-refTargets": [
          "Requirement"
        ]
      },
      "uniqueItems": true,
      "description": "NFR requirements that constrain this protocol (latency, availability, etc.)",
      "title": "bound by NFR",
      "x-sdd-layoutGroup": "technical",
      "x-sdd-order": 40
    },
    "supportsFeatureIds": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "sdd-ref",
        "x-sdd-refTargets": [
          "Feature"
        ]
      },
      "uniqueItems": true,
      "description": "Features that use this protocol",
      "title": "supports",
      "x-sdd-layoutGroup": "traceability",
      "x-sdd-order": 30
    },
    "governedByAdrIds": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "sdd-ref",
        "x-sdd-refTargets": [
          "ADR"
        ]
      },
      "uniqueItems": true,
      "description": "ADRs that govern this protocol",
      "title": "governed by",
      "x-sdd-layoutGroup": "traceability",
      "x-sdd-order": 40
    },
    "externalSpecRefs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "References to external spec documents (OpenAPI, AsyncAPI, etc.)",
      "x-sdd-layoutGroup": "technical",
      "x-sdd-order": 50
    },
    "createdDate": {
      "type": "string",
      "format": "date-time",
      "title": "Created Date",
      "description": "Date when this entity was first created",
      "x-sdd-displayLocation": "header"
    },
    "lastModifiedDate": {
      "type": "string",
      "format": "date-time",
      "title": "Last Modified Date",
      "description": "Date of last modification",
      "x-sdd-displayLocation": "header"
    },
    "lastModifiedBy": {
      "type": "string",
      "title": "Modified By",
      "description": "User or team who last modified this entity",
      "x-sdd-displayLocation": "header"
    },
    "affectedByThreatIds": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "sdd-ref",
        "x-sdd-refTargets": [
          "Threat"
        ]
      },
      "uniqueItems": true,
      "description": "Threats that affect/apply to this entity",
      "title": "affected by",
      "x-sdd-layoutGroup": "traceability",
      "x-sdd-order": 50
    },
    "governedByPolicyIds": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "sdd-ref",
        "x-sdd-refTargets": [
          "Policy"
        ]
      },
      "uniqueItems": true,
      "description": "Policys that affect/apply to this entity",
      "title": "governed by",
      "x-sdd-layoutGroup": "traceability",
      "x-sdd-order": 60
    },
    "usedInScenarioIds": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "sdd-ref",
        "x-sdd-refTargets": [
          "Scenario"
        ]
      },
      "uniqueItems": true,
      "description": "Scenarios that affect/apply to this entity",
      "title": "used in",
      "x-sdd-layoutGroup": "traceability",
      "x-sdd-order": 70
    },
    "telemetrySchemaIds": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "sdd-ref",
        "x-sdd-refTargets": [
          "TelemetrySchema"
        ]
      },
      "uniqueItems": true,
      "description": "TelemetrySchemas that affect/apply to this entity",
      "title": "observed by",
      "x-sdd-layoutGroup": "traceability",
      "x-sdd-order": 80
    }
  },
  "additionalProperties": false,
  "x-sdd-ui": {
    "title": "Protocol",
    "icon": "🔗",
    "displayNamePlural": "Protocols"
  },
  "x-sdd-displayHint": "markdown",
  "x-sdd-meta": {
    "createdDate": "2024-01-01T00:00:00Z",
    "lastModifiedDate": "2024-12-19T00:00:00Z",
    "lastModifiedBy": "ACT-ivan"
  },
  "x-sdd-layoutGroups": {
    "overview": {
      "title": "Overview",
      "order": 1
    },
    "technical": {
      "title": "Technical",
      "order": 2
    },
    "endpoints": {
      "title": "Endpoints",
      "order": 3
    },
    "traceability": {
      "title": "Traceability",
      "order": 4
    },
    "meta": {
      "title": "Meta",
      "order": 5
    }
  }
}
