        "type": "string",
        "format": "sdd-ref",
        "x-sdd-refTargets": [
          "ConformanceSuite"
        ]
      },
      "uniqueItems": true,
      "x-sdd-layoutGroup": "traceability",
      "x-sdd-order": 27
    },
    "relatedFormatIds": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "sdd-ref",
