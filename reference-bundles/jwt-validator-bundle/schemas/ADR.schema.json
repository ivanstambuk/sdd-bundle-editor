      "uniqueItems": true,
      "x-sdd-layoutGroup": "traceability",
      "x-sdd-order": 20
    },
    "relatedOperationIds": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "sdd-ref",
        "x-sdd-refTargets": [
