{
  "$id": "sdd-bundle:jwt-validator:ValidationRule",
  "type": "object",
  "title": "ValidationRule",
  "required": [
    "id",
    "kind",
    "title"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^RULE-[a-zA-Z0-9-]+$",
      "x-sdd-displayHint": "hidden",
      "x-sdd-layoutGroup": "overview"
    },
    "kind": {
      "type": "string",
      "const": "ValidationRule",
      "x-sdd-displayHint": "hidden",
      "x-sdd-layoutGroup": "overview"
    },
    "title": {
      "type": "string",
      "x-sdd-layoutGroup": "overview",
      "x-sdd-order": 10
    },
    "description": {
      "type": "string",
      "x-sdd-displayHint": "markdown",
      "x-sdd-layoutGroup": "overview",
      "x-sdd-prominence": "primary",
      "x-sdd-prominenceLabel": "Description",
      "x-sdd-prominenceIcon": "📝",
      "x-sdd-order": 20
    },
    "rationale": {
      "type": "string",
      "x-sdd-displayHint": "markdown",
      "x-sdd-layoutGroup": "overview",
      "x-sdd-prominence": "secondary",
      "x-sdd-prominenceLabel": "Rationale",
      "x-sdd-prominenceIcon": "🤔",
      "x-sdd-order": 30
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "x-sdd-displayHint": "chips",
      "x-sdd-layoutGroup": "overview",
      "x-sdd-order": 99
    },
    "governedByAdrIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "x-sdd-refTargets": [
        "ADR"
      ],
      "x-sdd-layoutGroup": "traceability",
      "x-sdd-order": 10
    },
    "ruleType": {
      "type": "string",
      "enum": [
        "TimeCheck",
        "StringMatch",
        "AbsenceCheck",
        "Regex",
        "CryptoVerify"
      ],
      "x-sdd-layoutGroup": "details",
      "x-sdd-order": 10
    },
    "parameters": {
      "type": "object",
      "x-sdd-layoutGroup": "details",
      "x-sdd-order": 20
    },
    "throwsErrorCodeId": {
      "type": "string",
      "x-sdd-refTargets": [
        "ErrorCode"
      ],
      "x-sdd-layoutGroup": "traceability",
      "x-sdd-order": 20
    },
    "implementsConstraintIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "x-sdd-refTargets": [
        "SecurityConstraint"
      ],
      "x-sdd-layoutGroup": "traceability",
      "x-sdd-order": 30
    },
    "implementsReferenceIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "x-sdd-refTargets": [
        "NormativeReference"
      ],
      "x-sdd-layoutGroup": "traceability",
      "x-sdd-order": 40
    },
    "bindsToContextPropertyId": {
      "type": "string",
      "x-sdd-refTargets": [
        "DataStructure"
      ],
      "x-sdd-layoutGroup": "traceability",
      "x-sdd-order": 50
    },
    "severity": {
      "type": "string",
      "enum": [
        "INFO",
        "WARN",
        "ERROR",
        "FATAL",
        "CRITICAL"
      ],
      "x-sdd-layoutGroup": "details",
      "x-sdd-order": 5
    }
  },
  "x-sdd-ui": {
    "displayName": "Validation Rule",
    "displayNamePlural": "Validation Rules",
    "icon": "✅"
  },
  "x-sdd-layoutGroups": {
    "overview": {
      "title": "Overview",
      "order": 1
    },
    "details": {
      "title": "Properties & Configuration",
      "order": 2
    },
    "traceability": {
      "title": "Relationships",
      "order": 3
    }
  }
}