{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Participant",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "participantName",
    "kind"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^PART-[a-z0-9-]+$",
      "x-sdd-entityType": "Participant",
      "x-sdd-idTemplate": "PART-{slug}"
    },
    "title": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "participantName": {
      "type": "string"
    },
    "abbreviation": {
      "type": "string"
    },
    "kind": {
      "type": "string"
    },
    "parentParticipantId": {
      "type": "string",
      "format": "sdd-ref",
      "x-sdd-refTargets": [
        "Participant"
      ]
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "x-sdd-displayHint": "chips"
    },
    "sourceServiceIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "x-sdd-displayHint": "chips"
    },
    "normativeCitationIds": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "sdd-ref",
        "x-sdd-refTargets": [
          "NormativeCitation"
        ]
      },
      "x-sdd-displayHint": "chips"
    },
    "sourceBootstrapParticipantId": {
      "type": "string"
    },
    "notes": {
      "type": "string",
      "x-sdd-displayHint": "markdown"
    }
  }
}
