    "kind",
    "executionStatus",
    "artifactClass",
    "lifecycleStatus",
    "title",
    "status",
    "createdDate",
    "decidedDate",
    "lastModifiedDate",
    "lastModifiedBy",
    "deciderActorIds",
    "context",
    "problem",
    "alternativesConsidered",
    "decision"
