{
  "$id": "sdd-bundle:jwt-validator:MockKeySet",
  "type": "object",
  "title": "MockKeySet",
  "required": [
    "id",
    "kind",
    "title"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^MOCK-[a-z0-9-]+$",
      "x-sdd-displayHint": "hidden",
      "x-sdd-layoutGroup": "overview"
    },
    "kind": {
      "type": "string",
      "const": "MockKeySet",
      "x-sdd-displayHint": "hidden",
      "x-sdd-layoutGroup": "overview"
    },
    "title": {
      "type": "string",
      "x-sdd-layoutGroup": "overview",
      "x-sdd-order": 10
    },
    "description": {
      "type": "string",
      "x-sdd-displayHint": "markdown",
      "x-sdd-layoutGroup": "overview",
      "x-sdd-prominence": "primary",
      "x-sdd-prominenceLabel": "Description",
      "x-sdd-prominenceIcon": "📝",
      "x-sdd-order": 20
    },
    "rationale": {
      "type": "string",
      "x-sdd-displayHint": "markdown",
      "x-sdd-layoutGroup": "overview",
      "x-sdd-prominence": "secondary",
      "x-sdd-prominenceLabel": "Rationale",
      "x-sdd-prominenceIcon": "🤔",
      "x-sdd-order": 30
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "x-sdd-displayHint": "chips",
      "x-sdd-layoutGroup": "overview",
      "x-sdd-order": 99
    },
    "executionStatus": {
      "type": "string",
      "title": "Execution Status",
      "description": "Whether this artifact is part of the active executable contract, advisory-only, or planned for later execution.",
      "enum": [
        "active",
        "advisory",
        "planned"
      ],
      "x-sdd-layoutGroup": "details",
      "x-sdd-order": 1
    },
    "artifactClass": {
      "type": "string",
      "title": "Artifact Class",
      "description": "Classifies whether this entity is part of the contract, a support artifact, fixture infrastructure, or documentation.",
      "enum": [
        "contract",
        "support",
        "fixture",
        "documentation"
      ],
      "x-sdd-layoutGroup": "details",
      "x-sdd-order": 2
    },
    "lifecycleStatus": {
      "type": "string",
      "title": "Lifecycle Status",
      "description": "Tracks whether this artifact is still draft, active, deprecated, or superseded.",
      "enum": [
        "draft",
        "active",
        "deprecated",
        "superseded"
      ],
      "x-sdd-layoutGroup": "details",
      "x-sdd-order": 3
    },
    "governedByAdrIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "x-sdd-refTargets": [
        "ADR"
      ],
      "x-sdd-layoutGroup": "traceability",
      "x-sdd-order": 10,
      "title": "Governed By Adr References",
      "description": "References related ADR entity."
    },
    "fixtureMode": {
      "type": "string",
      "enum": [
        "static-keyset",
        "remote-jwks-response",
        "oidc-discovery-document"
      ],
      "x-sdd-layoutGroup": "details",
      "x-sdd-order": 8
    },
    "endpointUrl": {
      "type": "string",
      "x-sdd-layoutGroup": "details",
      "x-sdd-order": 9
    },
    "jwks": {
      "type": "object",
      "x-sdd-layoutGroup": "details",
      "x-sdd-order": 10
    },
    "httpStatusCode": {
      "type": "integer",
      "minimum": 100,
      "maximum": 599,
      "x-sdd-layoutGroup": "details",
      "x-sdd-order": 11
    },
    "responseHeaders": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "x-sdd-layoutGroup": "details",
      "x-sdd-order": 12
    },
    "cacheDisposition": {
      "type": "string",
      "enum": [
        "none",
        "cold-start",
        "warm-cache",
        "stale-cache",
        "refresh-target"
      ],
      "x-sdd-layoutGroup": "details",
      "x-sdd-order": 13
    },
    "networkBehavior": {
      "type": "string",
      "enum": [
        "success",
        "retryable-failure",
        "permanent-failure"
      ],
      "x-sdd-layoutGroup": "details",
      "x-sdd-order": 14
    },
    "discoveryDocument": {
      "type": "object",
      "x-sdd-layoutGroup": "details",
      "x-sdd-order": 15
    },
    "linkedJwksFixtureId": {
      "type": "string",
      "x-sdd-refTargets": [
        "MockKeySet"
      ],
      "x-sdd-layoutGroup": "traceability",
      "x-sdd-order": 19,
      "format": "sdd-ref",
      "title": "Linked JWKS Fixture Reference",
      "description": "References the JWKS fixture used after resolving discovery metadata."
    },
    "supersedesFixtureId": {
      "type": "string",
      "x-sdd-refTargets": [
        "MockKeySet"
      ],
      "x-sdd-layoutGroup": "traceability",
      "x-sdd-order": 20,
      "format": "sdd-ref",
      "title": "Supersedes Fixture Reference",
      "description": "References the earlier fixture state that this remote response supersedes during rollover or refresh."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "fixtureMode": {
            "const": "remote-jwks-response"
          }
        },
        "required": [
          "fixtureMode"
        ]
      },
      "then": {
        "properties": {
          "endpointUrl": {},
          "httpStatusCode": {},
          "cacheDisposition": {},
          "networkBehavior": {}
        },
        "required": [
          "endpointUrl",
          "httpStatusCode",
          "cacheDisposition",
          "networkBehavior"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "fixtureMode": {
            "const": "oidc-discovery-document"
          }
        },
        "required": [
          "fixtureMode"
        ]
      },
      "then": {
        "properties": {
          "endpointUrl": {},
          "httpStatusCode": {},
          "cacheDisposition": {},
          "networkBehavior": {},
          "discoveryDocument": {}
        },
        "required": [
          "endpointUrl",
          "httpStatusCode",
          "cacheDisposition",
          "networkBehavior",
          "discoveryDocument"
        ]
      }
    }
  ],
  "x-sdd-ui": {
    "displayName": "Mock Key Set",
    "displayNamePlural": "Mock Key Sets",
    "icon": "🖇️"
  },
  "x-sdd-layoutGroups": {
    "overview": {
      "title": "Overview",
      "order": 1
    },
    "details": {
      "title": "Properties & Configuration",
      "order": 2
    },
    "traceability": {
      "title": "Relationships",
      "order": 3
    }
  }
}
