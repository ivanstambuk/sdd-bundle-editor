{
  "$id": "sdd-bundle:crypto-profile:DataStructure",
  "type": "object",
  "title": "DataStructure",
  "required": ["id", "kind", "title", "executionStatus", "artifactClass", "lifecycleStatus", "structureKind"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^STRUCT-[a-z0-9-]+$", "x-sdd-displayHint": "hidden", "x-sdd-layoutGroup": "overview" },
    "kind": { "type": "string", "const": "DataStructure", "x-sdd-displayHint": "hidden", "x-sdd-layoutGroup": "overview" },
    "title": { "type": "string", "x-sdd-layoutGroup": "overview", "x-sdd-order": 10 },
    "description": { "type": "string", "x-sdd-displayHint": "markdown", "x-sdd-layoutGroup": "overview", "x-sdd-order": 20 },
    "structureKind": { "type": "string", "enum": ["conceptual-type", "context-state", "input-model", "output-model", "test-vector-model"], "x-sdd-layoutGroup": "details", "x-sdd-order": 10 },
    "formatType": { "type": "string", "x-sdd-layoutGroup": "details", "x-sdd-order": 11 },
    "executionStatus": { "type": "string", "enum": ["active", "advisory", "planned"], "x-sdd-layoutGroup": "details", "x-sdd-order": 1 },
    "artifactClass": { "type": "string", "enum": ["contract", "support", "fixture", "documentation"], "x-sdd-layoutGroup": "details", "x-sdd-order": 2 },
    "lifecycleStatus": { "type": "string", "enum": ["draft", "active", "deprecated", "superseded"], "x-sdd-layoutGroup": "details", "x-sdd-order": 3 },
    "schemaDefinition": { "type": "object", "additionalProperties": true, "x-sdd-layoutGroup": "details", "x-sdd-order": 12 },
    "samplePayload": { "type": "string", "x-sdd-displayHint": "markdown", "x-sdd-layoutGroup": "details", "x-sdd-order": 13 },
    "composesStructureIds": {
      "type": "array",
      "items": { "type": "string", "format": "sdd-ref", "x-sdd-refTargets": ["DataStructure"] },
      "x-sdd-layoutGroup": "traceability",
      "x-sdd-order": 20,
      "title": "composes"
    }
  },
  "x-sdd-ui": { "displayName": "Data Structure", "displayNamePlural": "Data Structures", "icon": "🏗️" },
  "x-sdd-layoutGroups": {
    "overview": { "title": "Overview", "order": 1 },
    "details": { "title": "Properties & Configuration", "order": 2 },
    "traceability": { "title": "Relationships", "order": 3 }
  }
}
