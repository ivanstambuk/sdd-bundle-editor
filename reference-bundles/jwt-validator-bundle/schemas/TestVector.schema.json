      },
      "then": {
        "properties": {
          "expectedOutcomeClass": {},
          "validatesRuleIds": {},
          "invocationProfileId": {},
          "expectedEvaluatedProfileId": {}
        },
        "required": [
          "expectedOutcomeClass",
          "validatesRuleIds",
          "invocationProfileId",
          "expectedEvaluatedProfileId"
        ]
      }
    }
  ],
  "x-sdd-ui": {
    "displayName": "Test Vector",
    "displayNamePlural": "Test Vectors",
    "icon": "🎯"
  },
  "x-sdd-layoutGroups": {
    "overview": {
      "title": "Overview",
      "order": 1
    },
    "details": {
      "title": "Properties & Configuration",
      "order": 2
