        "url": "https://superengineer.net/spacex-5-rules-engineering-process/",
        "type": "methodology"
      },
      {
        "label": "TOGAF Requirements Management",
        "url": "https://www.visual-paradigm.com/guide/togaf/togaf-adm-requirements-management/",
        "type": "framework"
      },
      {
        "label": "TOGAF Stakeholder Analysis",
        "url": "https://www.visual-paradigm.com/guide/togaf/togaf-stakeholder-management/",
        "type": "framework"
      },
      {
