{
  "$id": "sdd-bundle:jwt-validator:NormativeReference",
  "type": "object",
  "title": "NormativeReference",
  "required": [
    "id",
    "kind",
    "title",
    "executionStatus",
    "artifactClass",
    "lifecycleStatus"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^(RFC-[0-9]+|OIDC-[A-Z0-9_-]+|OAUTH-[A-Z0-9_-]+|FAPI-[A-Z0-9_-]+)$",
      "x-sdd-displayHint": "hidden",
      "x-sdd-layoutGroup": "overview"
    },
    "kind": {
      "type": "string",
      "const": "NormativeReference",
      "x-sdd-displayHint": "hidden",
      "x-sdd-layoutGroup": "overview"
    },
    "title": {
      "type": "string",
      "x-sdd-layoutGroup": "overview",
      "x-sdd-order": 10
    },
    "description": {
      "type": "string",
      "x-sdd-displayHint": "markdown",
      "x-sdd-layoutGroup": "overview",
      "x-sdd-prominence": "primary",
      "x-sdd-prominenceLabel": "Description",
      "x-sdd-prominenceIcon": "📝",
      "x-sdd-order": 20
    },
    "rationale": {
      "type": "string",
      "x-sdd-displayHint": "markdown",
      "x-sdd-layoutGroup": "overview",
      "x-sdd-prominence": "secondary",
      "x-sdd-prominenceLabel": "Rationale",
      "x-sdd-prominenceIcon": "🤔",
      "x-sdd-order": 30
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "x-sdd-displayHint": "chips",
      "x-sdd-layoutGroup": "overview",
      "x-sdd-order": 99
    },
    "executionStatus": {
      "type": "string",
      "title": "Execution Status",
      "description": "Whether this artifact is part of the active executable contract, advisory-only, or planned for later execution.",
      "enum": [
        "active",
        "advisory",
        "planned"
      ],
      "x-sdd-layoutGroup": "details",
      "x-sdd-order": 1
    },
    "artifactClass": {
      "type": "string",
      "title": "Artifact Class",
      "description": "Classifies whether this entity is part of the contract, a support artifact, fixture infrastructure, or documentation.",
      "enum": [
        "contract",
        "support",
        "fixture",
        "documentation"
      ],
      "x-sdd-layoutGroup": "details",
      "x-sdd-order": 2
    },
    "lifecycleStatus": {
      "type": "string",
      "title": "Lifecycle Status",
      "description": "Tracks whether this artifact is still draft, active, deprecated, or superseded.",
      "enum": [
        "draft",
        "active",
        "deprecated",
        "superseded"
      ],
      "x-sdd-layoutGroup": "details",
      "x-sdd-order": 3
    },
    "governedByAdrIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "x-sdd-refTargets": [
        "ADR"
      ],
      "x-sdd-layoutGroup": "traceability",
      "x-sdd-order": 10,
      "title": "Governed By Adr References",
      "description": "References related ADR entity."
    },
    "url": {
      "type": "string",
      "format": "uri",
      "x-sdd-layoutGroup": "details",
      "x-sdd-order": 10
    },
    "referenceType": {
      "type": "string",
      "enum": [
        "RFC",
        "OIDC",
        "OAuth2",
        "FAPI"
      ],
      "x-sdd-layoutGroup": "details",
      "x-sdd-order": 12
    },
    "publisher": {
      "type": "string",
      "x-sdd-layoutGroup": "details",
      "x-sdd-order": 15
    },
    "section": {
      "type": "string",
      "x-sdd-layoutGroup": "details",
      "x-sdd-order": 20
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "executionStatus": {
            "const": "active"
          }
        },
        "required": [
          "executionStatus"
        ]
      },
      "then": {
        "properties": {
          "url": {},
          "referenceType": {},
          "publisher": {}
        },
        "required": [
          "url",
          "referenceType",
          "publisher"
        ]
      }
    }
  ],
  "x-sdd-ui": {
    "displayName": "Normative Reference",
    "displayNamePlural": "Normative References",
    "icon": "📚"
  },
  "x-sdd-layoutGroups": {
    "overview": {
      "title": "Overview",
      "order": 1
    },
    "details": {
      "title": "Properties & Configuration",
      "order": 2
    },
    "traceability": {
      "title": "Relationships",
      "order": 3
    }
  }
}
