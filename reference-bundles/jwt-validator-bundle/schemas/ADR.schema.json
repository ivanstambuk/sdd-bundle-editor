      "x-sdd-order": 10
    },
    "createdDate": {
      "type": "string",
      "format": "date-time",
      "x-sdd-layoutGroup": "details",
      "x-sdd-order": 11
    },
    "decidedDate": {
      "type": "string",
      "format": "date-time",
      "x-sdd-layoutGroup": "details",
