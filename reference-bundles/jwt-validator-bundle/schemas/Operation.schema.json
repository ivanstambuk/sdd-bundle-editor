{
  "$id": "sdd-bundle:jwt-validator:Operation",
  "type": "object",
  "title": "Operation",
  "required": [
    "id",
    "kind",
    "title",
    "executionStatus",
    "artifactClass",
    "lifecycleStatus"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^OP-[a-zA-Z0-9-]+$",
      "x-sdd-displayHint": "hidden",
      "x-sdd-layoutGroup": "overview"
    },
    "kind": {
      "type": "string",
      "const": "Operation",
      "x-sdd-displayHint": "hidden",
      "x-sdd-layoutGroup": "overview"
    },
    "title": {
      "type": "string",
      "x-sdd-layoutGroup": "overview",
      "x-sdd-order": 10
    },
    "description": {
      "type": "string",
      "x-sdd-displayHint": "markdown",
      "x-sdd-layoutGroup": "overview",
      "x-sdd-prominence": "primary",
      "x-sdd-prominenceLabel": "Description",
      "x-sdd-prominenceIcon": "📝",
      "x-sdd-order": 20
    },
    "rationale": {
      "type": "string",
      "x-sdd-displayHint": "markdown",
      "x-sdd-layoutGroup": "overview",
      "x-sdd-prominence": "secondary",
      "x-sdd-prominenceLabel": "Rationale",
      "x-sdd-prominenceIcon": "🤔",
      "x-sdd-order": 30
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "x-sdd-displayHint": "chips",
      "x-sdd-layoutGroup": "overview",
      "x-sdd-order": 99
    },
    "executionStatus": {
      "type": "string",
      "title": "Execution Status",
      "description": "Whether this artifact is part of the active executable contract, advisory-only, or planned for later execution.",
      "enum": [
        "active",
        "advisory",
        "planned"
      ],
      "x-sdd-layoutGroup": "details",
      "x-sdd-order": 1
    },
    "artifactClass": {
      "type": "string",
      "title": "Artifact Class",
      "description": "Classifies whether this entity is part of the contract, a support artifact, fixture infrastructure, or documentation.",
      "enum": [
        "contract",
        "support",
        "fixture",
        "documentation"
      ],
      "x-sdd-layoutGroup": "details",
      "x-sdd-order": 2
    },
    "lifecycleStatus": {
      "type": "string",
      "title": "Lifecycle Status",
      "description": "Tracks whether this artifact is still draft, active, deprecated, or superseded.",
      "enum": [
        "draft",
        "active",
        "deprecated",
        "superseded"
      ],
      "x-sdd-layoutGroup": "details",
      "x-sdd-order": 3
    },
    "governedByAdrIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "x-sdd-refTargets": [
        "ADR"
      ],
      "x-sdd-layoutGroup": "traceability",
      "x-sdd-order": 10,
      "title": "Governed By Adr References",
      "description": "References related ADR entity."
    },
    "acceptsStructureIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "x-sdd-refTargets": [
        "DataStructure"
      ],
      "x-sdd-layoutGroup": "traceability",
      "x-sdd-order": 20,
      "title": "Accepts Structure References",
      "description": "References related DataStructure entity."
    },
    "systemComponent": {
      "type": "string",
      "description": "Implementation hint for support tooling only. Not part of the normative contract surface for authoritative operations.",
      "x-sdd-layoutGroup": "details",
      "x-sdd-order": 15
    },
    "operationRole": {
      "type": "string",
      "enum": [
        "authoritative",
        "diagnostic",
        "parser",
        "harness"
      ],
      "x-sdd-layoutGroup": "details",
      "x-sdd-order": 12
    },
    "producesDataStructureIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "x-sdd-refTargets": [
        "DataStructure"
      ],
      "x-sdd-layoutGroup": "traceability",
      "x-sdd-order": 40,
      "title": "Produces Data Structure References",
      "description": "References related DataStructure entity."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "executionStatus": {
            "const": "active"
          },
          "artifactClass": {
            "const": "contract"
          }
        },
        "required": [
          "executionStatus",
          "artifactClass"
        ]
      },
      "then": {
        "properties": {
          "operationRole": {},
          "acceptsStructureIds": {},
          "producesDataStructureIds": {}
        },
        "required": [
          "operationRole",
          "acceptsStructureIds",
          "producesDataStructureIds"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "executionStatus": {
            "const": "active"
          }
        },
        "required": [
          "executionStatus"
        ]
      },
      "then": {
        "properties": {
          "operationRole": {}
        },
        "required": [
          "operationRole"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "artifactClass": {
            "const": "contract"
          }
        },
        "required": [
          "artifactClass"
        ]
      },
      "then": {
        "not": {
          "properties": {
            "systemComponent": {}
          },
          "required": [
            "systemComponent"
          ]
        }
      }
    }
  ],
  "x-sdd-ui": {
    "displayName": "Operation",
    "displayNamePlural": "Operations",
    "icon": "⚡"
  },
  "x-sdd-layoutGroups": {
    "overview": {
      "title": "Overview",
      "order": 1
    },
    "details": {
      "title": "Properties & Configuration",
      "order": 2
    },
    "traceability": {
      "title": "Relationships",
      "order": 3
    }
  }
}
