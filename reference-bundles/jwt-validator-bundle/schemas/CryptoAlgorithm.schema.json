{
  "$id": "sdd-bundle:jwt-validator:CryptoAlgorithm",
  "type": "object",
  "title": "CryptoAlgorithm",
  "required": [
    "id",
    "kind",
    "title"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^ALG-[a-zA-Z0-9]+$",
      "x-sdd-displayHint": "hidden",
      "x-sdd-layoutGroup": "overview"
    },
    "kind": {
      "type": "string",
      "const": "CryptoAlgorithm",
      "x-sdd-displayHint": "hidden",
      "x-sdd-layoutGroup": "overview"
    },
    "title": {
      "type": "string",
      "x-sdd-layoutGroup": "overview",
      "x-sdd-order": 10
    },
    "description": {
      "type": "string",
      "x-sdd-displayHint": "markdown",
      "x-sdd-layoutGroup": "overview",
      "x-sdd-prominence": "primary",
      "x-sdd-prominenceLabel": "Description",
      "x-sdd-prominenceIcon": "📝",
      "x-sdd-order": 20
    },
    "rationale": {
      "type": "string",
      "x-sdd-displayHint": "markdown",
      "x-sdd-layoutGroup": "overview",
      "x-sdd-prominence": "secondary",
      "x-sdd-prominenceLabel": "Rationale",
      "x-sdd-prominenceIcon": "🤔",
      "x-sdd-order": 30
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "x-sdd-displayHint": "chips",
      "x-sdd-layoutGroup": "overview",
      "x-sdd-order": 99
    },
    "governedByAdrIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "x-sdd-refTargets": [
        "ADR"
      ],
      "x-sdd-layoutGroup": "traceability",
      "x-sdd-order": 10
    },
    "joseName": {
      "type": "string",
      "x-sdd-layoutGroup": "details",
      "x-sdd-order": 10
    },
    "keyFamily": {
      "type": "string",
      "enum": [
        "RSA",
        "EC",
        "OCT",
        "NONE"
      ],
      "x-sdd-layoutGroup": "details",
      "x-sdd-order": 20
    },
    "minKeySizeBits": {
      "type": "integer",
      "x-sdd-layoutGroup": "details",
      "x-sdd-order": 30
    },
    "isQuantumSafe": {
      "type": "boolean",
      "x-sdd-layoutGroup": "details",
      "x-sdd-order": 40
    },
    "strengthBits": {
      "type": "integer",
      "x-sdd-layoutGroup": "details",
      "x-sdd-order": 50
    }
  },
  "x-sdd-ui": {
    "displayName": "Crypto Algorithm",
    "displayNamePlural": "Crypto Algorithms",
    "icon": "🧮"
  },
  "x-sdd-layoutGroups": {
    "overview": {
      "title": "Overview",
      "order": 1
    },
    "details": {
      "title": "Properties & Configuration",
      "order": 2
    },
    "traceability": {
      "title": "Relationships",
      "order": 3
    }
  }
}