{
  "$id": "sdd-bundle:jwt-validator:ValidationStep",
  "type": "object",
  "title": "ValidationStep",
  "required": [
    "id",
    "kind",
    "title",
    "executionStatus",
    "artifactClass",
    "lifecycleStatus"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^STEP-[0-9]+$",
      "x-sdd-displayHint": "hidden",
      "x-sdd-layoutGroup": "overview"
    },
    "kind": {
      "type": "string",
      "const": "ValidationStep",
      "x-sdd-displayHint": "hidden",
      "x-sdd-layoutGroup": "overview"
    },
    "title": {
      "type": "string",
      "x-sdd-layoutGroup": "overview",
      "x-sdd-order": 10
    },
    "description": {
      "type": "string",
      "x-sdd-displayHint": "markdown",
      "x-sdd-layoutGroup": "overview",
      "x-sdd-prominence": "primary",
      "x-sdd-prominenceLabel": "Description",
      "x-sdd-prominenceIcon": "📝",
      "x-sdd-order": 20
    },
    "rationale": {
      "type": "string",
      "x-sdd-displayHint": "markdown",
      "x-sdd-layoutGroup": "overview",
      "x-sdd-prominence": "secondary",
      "x-sdd-prominenceLabel": "Rationale",
      "x-sdd-prominenceIcon": "🤔",
      "x-sdd-order": 30
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "x-sdd-displayHint": "chips",
      "x-sdd-layoutGroup": "overview",
      "x-sdd-order": 99
    },
    "executionStatus": {
      "type": "string",
      "title": "Execution Status",
      "description": "Whether this artifact is part of the active executable contract, advisory-only, or planned for later execution.",
      "enum": [
        "active",
        "advisory",
        "planned"
      ],
      "x-sdd-layoutGroup": "details",
      "x-sdd-order": 1
    },
    "artifactClass": {
      "type": "string",
      "title": "Artifact Class",
      "description": "Classifies whether this entity is part of the contract, a support artifact, fixture infrastructure, or documentation.",
      "enum": [
        "contract",
        "support",
        "fixture",
        "documentation"
      ],
      "x-sdd-layoutGroup": "details",
      "x-sdd-order": 2
    },
    "lifecycleStatus": {
      "type": "string",
      "title": "Lifecycle Status",
      "description": "Tracks whether this artifact is still draft, active, deprecated, or superseded.",
      "enum": [
        "draft",
        "active",
        "deprecated",
        "superseded"
      ],
      "x-sdd-layoutGroup": "details",
      "x-sdd-order": 3
    },
    "governedByAdrIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "x-sdd-refTargets": [
        "ADR"
      ],
      "x-sdd-layoutGroup": "traceability",
      "x-sdd-order": 10,
      "title": "Governed By Adr References",
      "description": "References related ADR entity."
    },
    "executionOrder": {
      "type": "integer",
      "minimum": 1,
      "x-sdd-layoutGroup": "details",
      "x-sdd-order": 10
    },
    "executesRuleIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "x-sdd-refTargets": [
        "ValidationRule"
      ],
      "x-sdd-layoutGroup": "traceability",
      "x-sdd-order": 20,
      "title": "Executes Rule References",
      "description": "References related ValidationRule entity."
    },
    "producesErrorCodeIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "x-sdd-refTargets": [
        "ErrorCode"
      ],
      "x-sdd-layoutGroup": "traceability",
      "x-sdd-order": 30,
      "title": "Produces Error Code References",
      "description": "References related ErrorCode entity."
    },
    "abortOnFailure": {
      "type": "boolean",
      "x-sdd-layoutGroup": "details",
      "x-sdd-order": 15
    },
    "successfulCompletionProjection": {
      "type": "object",
      "additionalProperties": false,
      "description": "Optional public-result state that becomes established once this step completes successfully.",
      "properties": {
        "trustDecision": {
          "type": "string",
          "enum": [
            "trusted",
            "rejected",
            "indeterminate"
          ]
        },
        "keySelectionStatus": {
          "type": "string",
          "enum": [
            "not-applicable",
            "resolved",
            "missing",
            "ambiguous"
          ]
        }
      },
      "minProperties": 1,
      "x-sdd-layoutGroup": "details",
      "x-sdd-order": 16
    },
    "preserveProjectedFieldsOnLaterFailure": {
      "type": "array",
      "description": "Projected fields from this step that must be preserved if a later step fails without explicitly overriding them.",
      "items": {
        "type": "string",
        "enum": [
          "trustDecision",
          "keySelectionStatus"
        ]
      },
      "uniqueItems": true,
      "x-sdd-layoutGroup": "details",
      "x-sdd-order": 17
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "executionStatus": {
            "const": "active"
          },
          "artifactClass": {
            "const": "contract"
          }
        },
        "required": [
          "executionStatus",
          "artifactClass"
        ]
      },
      "then": {
        "properties": {
          "executionOrder": {},
          "executesRuleIds": {},
          "abortOnFailure": {}
        },
        "required": [
          "executionOrder",
          "executesRuleIds",
          "abortOnFailure"
        ]
      }
    }
  ],
  "x-sdd-ui": {
    "displayName": "Validation Step",
    "displayNamePlural": "Validation Steps",
    "icon": "⚙️"
  },
  "x-sdd-layoutGroups": {
    "overview": {
      "title": "Overview",
      "order": 1
    },
    "details": {
      "title": "Properties & Configuration",
      "order": 2
    },
    "traceability": {
      "title": "Relationships",
      "order": 3
    }
  }
}
