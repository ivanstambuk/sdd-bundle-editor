{
  "$id": "sdd-bundle:jwt-validator:Operation",
  "type": "object",
  "title": "Operation",
  "required": [
    "id",
    "kind",
    "title"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^OP-[a-zA-Z0-9-]+$",
      "x-sdd-displayHint": "hidden",
      "x-sdd-layoutGroup": "overview"
    },
    "kind": {
      "type": "string",
      "const": "Operation",
      "x-sdd-displayHint": "hidden",
      "x-sdd-layoutGroup": "overview"
    },
    "title": {
      "type": "string",
      "x-sdd-layoutGroup": "overview",
      "x-sdd-order": 10
    },
    "description": {
      "type": "string",
      "x-sdd-displayHint": "markdown",
      "x-sdd-layoutGroup": "overview",
      "x-sdd-prominence": "primary",
      "x-sdd-prominenceLabel": "Description",
      "x-sdd-prominenceIcon": "📝",
      "x-sdd-order": 20
    },
    "rationale": {
      "type": "string",
      "x-sdd-displayHint": "markdown",
      "x-sdd-layoutGroup": "overview",
      "x-sdd-prominence": "secondary",
      "x-sdd-prominenceLabel": "Rationale",
      "x-sdd-prominenceIcon": "🤔",
      "x-sdd-order": 30
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "x-sdd-displayHint": "chips",
      "x-sdd-layoutGroup": "overview",
      "x-sdd-order": 99
    },
    "governedByAdrIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "x-sdd-refTargets": [
        "ADR"
      ],
      "x-sdd-layoutGroup": "traceability",
      "x-sdd-order": 10
    },
    "acceptsStructureIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "x-sdd-refTargets": [
        "DataStructure"
      ],
      "x-sdd-layoutGroup": "traceability",
      "x-sdd-order": 20
    },
    "systemComponent": {
      "type": "string",
      "x-sdd-layoutGroup": "details",
      "x-sdd-order": 15
    },
    "producesDataStructureIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "x-sdd-refTargets": [
        "DataStructure"
      ],
      "x-sdd-layoutGroup": "traceability",
      "x-sdd-order": 40
    }
  },
  "x-sdd-ui": {
    "displayName": "Operation",
    "displayNamePlural": "Operations",
    "icon": "⚡"
  },
  "x-sdd-layoutGroups": {
    "overview": {
      "title": "Overview",
      "order": 1
    },
    "details": {
      "title": "Properties & Configuration",
      "order": 2
    },
    "traceability": {
      "title": "Relationships",
      "order": 3
    }
  }
}