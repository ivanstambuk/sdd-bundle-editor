{
  "$id": "sdd-bundle:jwt-validator:ValidationRule",
  "type": "object",
  "title": "ValidationRule",
  "required": [
    "id",
    "kind",
    "title",
    "executionStatus",
    "artifactClass",
    "lifecycleStatus"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^RULE-[a-zA-Z0-9-]+$",
      "x-sdd-displayHint": "hidden",
      "x-sdd-layoutGroup": "overview"
    },
    "kind": {
      "type": "string",
      "const": "ValidationRule",
      "x-sdd-displayHint": "hidden",
      "x-sdd-layoutGroup": "overview"
    },
    "title": {
      "type": "string",
      "x-sdd-layoutGroup": "overview",
      "x-sdd-order": 10
    },
    "description": {
      "type": "string",
      "x-sdd-displayHint": "markdown",
      "x-sdd-layoutGroup": "overview",
      "x-sdd-prominence": "primary",
      "x-sdd-prominenceLabel": "Description",
      "x-sdd-prominenceIcon": "📝",
      "x-sdd-order": 20
    },
    "rationale": {
      "type": "string",
      "x-sdd-displayHint": "markdown",
      "x-sdd-layoutGroup": "overview",
      "x-sdd-prominence": "secondary",
      "x-sdd-prominenceLabel": "Rationale",
      "x-sdd-prominenceIcon": "🤔",
      "x-sdd-order": 30
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "x-sdd-displayHint": "chips",
      "x-sdd-layoutGroup": "overview",
      "x-sdd-order": 99
    },
    "executionStatus": {
      "type": "string",
      "title": "Execution Status",
      "description": "Whether this artifact is part of the active executable contract, advisory-only, or planned for later execution.",
      "enum": [
        "active",
        "advisory",
        "planned"
      ],
      "x-sdd-layoutGroup": "details",
      "x-sdd-order": 1
    },
    "artifactClass": {
      "type": "string",
      "title": "Artifact Class",
      "description": "Classifies whether this entity is part of the contract, a support artifact, fixture infrastructure, or documentation.",
      "enum": [
        "contract",
        "support",
        "fixture",
        "documentation"
      ],
      "x-sdd-layoutGroup": "details",
      "x-sdd-order": 2
    },
    "lifecycleStatus": {
      "type": "string",
      "title": "Lifecycle Status",
      "description": "Tracks whether this artifact is still draft, active, deprecated, or superseded.",
      "enum": [
        "draft",
        "active",
        "deprecated",
        "superseded"
      ],
      "x-sdd-layoutGroup": "details",
      "x-sdd-order": 3
    },
    "governedByAdrIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "x-sdd-refTargets": [
        "ADR"
      ],
      "x-sdd-layoutGroup": "traceability",
      "x-sdd-order": 10,
      "title": "Governed By Adr References",
      "description": "References related ADR entity."
    },
    "ruleType": {
      "type": "string",
      "enum": [
        "TimeCheck",
        "StringMatch",
        "AbsenceCheck",
        "Regex",
        "CryptoVerify",
        "FormatCheck",
        "HeaderPolicy"
      ],
      "x-sdd-layoutGroup": "details",
      "x-sdd-order": 10
    },
    "parameters": {
      "type": "object",
      "x-sdd-layoutGroup": "details",
      "x-sdd-order": 20
    },
    "throwsErrorCodeId": {
      "type": "string",
      "x-sdd-refTargets": [
        "ErrorCode"
      ],
      "x-sdd-layoutGroup": "traceability",
      "x-sdd-order": 20,
      "format": "sdd-ref",
      "title": "Throws Error Code Reference",
      "description": "References related ErrorCode entity."
    },
    "implementsConstraintIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "x-sdd-refTargets": [
        "SecurityConstraint"
      ],
      "x-sdd-layoutGroup": "traceability",
      "x-sdd-order": 30,
      "title": "Implements Constraint References",
      "description": "References related SecurityConstraint entity."
    },
    "implementsReferenceIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "x-sdd-refTargets": [
        "NormativeReference"
      ],
      "x-sdd-layoutGroup": "traceability",
      "x-sdd-order": 40,
      "title": "Implements Reference References",
      "description": "References related NormativeReference entity."
    },
    "bindsToContextPropertyId": {
      "type": "string",
      "x-sdd-refTargets": [
        "DataStructure"
      ],
      "x-sdd-layoutGroup": "traceability",
      "x-sdd-order": 50,
      "format": "sdd-ref",
      "title": "Binds To Context Property Reference",
      "description": "References related DataStructure entity."
    },
    "severity": {
      "type": "string",
      "enum": [
        "INFO",
        "WARN",
        "ERROR",
        "FATAL",
        "CRITICAL"
      ],
      "x-sdd-layoutGroup": "details",
      "x-sdd-order": 5
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "executionStatus": {
            "const": "active"
          },
          "artifactClass": {
            "const": "contract"
          }
        },
        "required": [
          "executionStatus",
          "artifactClass"
        ]
      },
      "then": {
        "properties": {
          "severity": {},
          "throwsErrorCodeId": {}
        },
        "required": [
          "severity",
          "throwsErrorCodeId"
        ],
        "anyOf": [
          {
            "properties": {
              "implementsReferenceIds": {}
            },
            "required": [
              "implementsReferenceIds"
            ]
          },
          {
            "properties": {
              "implementsConstraintIds": {}
            },
            "required": [
              "implementsConstraintIds"
            ]
          },
          {
            "properties": {
              "governedByAdrIds": {}
            },
            "required": [
              "governedByAdrIds"
            ]
          }
        ]
      }
    }
  ],
  "x-sdd-ui": {
    "displayName": "Validation Rule",
    "displayNamePlural": "Validation Rules",
    "icon": "✅"
  },
  "x-sdd-layoutGroups": {
    "overview": {
      "title": "Overview",
      "order": 1
    },
    "details": {
      "title": "Properties & Configuration",
      "order": 2
    },
    "traceability": {
      "title": "Relationships",
      "order": 3
    }
  }
}
