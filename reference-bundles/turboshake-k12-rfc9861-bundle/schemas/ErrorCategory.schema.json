{
  "$id": "sdd-bundle:crypto-profile:ErrorCategory",
  "type": "object",
  "title": "ErrorCategory",
  "required": ["id", "kind", "title", "executionStatus", "artifactClass", "lifecycleStatus", "canonicalTag"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^ERRCAT-[a-z0-9-]+$", "x-sdd-displayHint": "hidden", "x-sdd-layoutGroup": "overview" },
    "kind": { "type": "string", "const": "ErrorCategory", "x-sdd-displayHint": "hidden", "x-sdd-layoutGroup": "overview" },
    "title": { "type": "string", "x-sdd-layoutGroup": "overview", "x-sdd-order": 10 },
    "description": { "type": "string", "x-sdd-displayHint": "markdown", "x-sdd-layoutGroup": "overview", "x-sdd-order": 20 },
    "canonicalTag": { "type": "string", "x-sdd-layoutGroup": "details", "x-sdd-order": 10 },
    "sourceName": { "type": "string", "x-sdd-layoutGroup": "details", "x-sdd-order": 11 },
    "executionStatus": { "type": "string", "enum": ["active", "advisory", "planned"], "x-sdd-layoutGroup": "details", "x-sdd-order": 1 },
    "artifactClass": { "type": "string", "enum": ["contract", "support", "fixture", "documentation"], "x-sdd-layoutGroup": "details", "x-sdd-order": 2 },
    "lifecycleStatus": { "type": "string", "enum": ["draft", "active", "deprecated", "superseded"], "x-sdd-layoutGroup": "details", "x-sdd-order": 3 },
    "semantics": { "type": "string", "x-sdd-displayHint": "markdown", "x-sdd-layoutGroup": "details", "x-sdd-order": 12 }
  },
  "x-sdd-ui": { "displayName": "Error Category", "displayNamePlural": "Error Categories", "icon": "⛔" },
  "x-sdd-layoutGroups": {
    "overview": { "title": "Overview", "order": 1 },
    "details": { "title": "Properties & Configuration", "order": 2 }
  }
}
