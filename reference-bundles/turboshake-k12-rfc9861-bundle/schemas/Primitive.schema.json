{
  "$id": "sdd-bundle:crypto-profile:Primitive",
  "type": "object",
  "title": "Primitive",
  "required": ["id", "kind", "title", "executionStatus", "artifactClass", "lifecycleStatus", "primitiveCategory", "normativeReferenceIds"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^PRIM-[a-z0-9-]+$", "x-sdd-displayHint": "hidden", "x-sdd-layoutGroup": "overview" },
    "kind": { "type": "string", "const": "Primitive", "x-sdd-displayHint": "hidden", "x-sdd-layoutGroup": "overview" },
    "title": { "type": "string", "x-sdd-layoutGroup": "overview", "x-sdd-order": 10 },
    "description": { "type": "string", "x-sdd-displayHint": "markdown", "x-sdd-layoutGroup": "overview", "x-sdd-order": 20 },
    "primitiveCategory": { "type": "string", "enum": ["permutation", "xof", "xof-context", "mac", "helper"], "x-sdd-layoutGroup": "details", "x-sdd-order": 10 },
    "family": { "type": "string", "x-sdd-layoutGroup": "details", "x-sdd-order": 11 },
    "executionStatus": { "type": "string", "enum": ["active", "advisory", "planned"], "x-sdd-layoutGroup": "details", "x-sdd-order": 1 },
    "artifactClass": { "type": "string", "enum": ["contract", "support", "fixture", "documentation"], "x-sdd-layoutGroup": "details", "x-sdd-order": 2 },
    "lifecycleStatus": { "type": "string", "enum": ["draft", "active", "deprecated", "superseded"], "x-sdd-layoutGroup": "details", "x-sdd-order": 3 },
    "normativeReferenceIds": {
      "type": "array",
      "items": { "type": "string", "format": "sdd-ref", "x-sdd-refTargets": ["NormativeReference"] },
      "minItems": 1,
      "x-sdd-layoutGroup": "traceability",
      "x-sdd-order": 20,
      "title": "normative references"
    },
    "governedByConstraintIds": {
      "type": "array",
      "items": { "type": "string", "format": "sdd-ref", "x-sdd-refTargets": ["Constraint"] },
      "x-sdd-layoutGroup": "traceability",
      "x-sdd-order": 21,
      "title": "governed by"
    },
    "exposesOperationIds": {
      "type": "array",
      "items": { "type": "string", "format": "sdd-ref", "x-sdd-refTargets": ["Operation"] },
      "x-sdd-layoutGroup": "traceability",
      "x-sdd-order": 22,
      "title": "exposes operations"
    },
    "returnsErrorCategoryIds": {
      "type": "array",
      "items": { "type": "string", "format": "sdd-ref", "x-sdd-refTargets": ["ErrorCategory"] },
      "x-sdd-layoutGroup": "traceability",
      "x-sdd-order": 23,
      "title": "errors"
    },
    "inputStructureIds": {
      "type": "array",
      "items": { "type": "string", "format": "sdd-ref", "x-sdd-refTargets": ["DataStructure"] },
      "x-sdd-layoutGroup": "traceability",
      "x-sdd-order": 24,
      "title": "inputs"
    },
    "outputStructureIds": {
      "type": "array",
      "items": { "type": "string", "format": "sdd-ref", "x-sdd-refTargets": ["DataStructure"] },
      "x-sdd-layoutGroup": "traceability",
      "x-sdd-order": 25,
      "title": "outputs"
    },
    "notes": { "type": "string", "x-sdd-displayHint": "markdown", "x-sdd-layoutGroup": "details", "x-sdd-order": 30 }
  },
  "x-sdd-ui": { "displayName": "Primitive", "displayNamePlural": "Primitives", "icon": "🧮" },
  "x-sdd-layoutGroups": {
    "overview": { "title": "Overview", "order": 1 },
    "details": { "title": "Properties & Configuration", "order": 2 },
    "traceability": { "title": "Relationships", "order": 3 }
  }
}
