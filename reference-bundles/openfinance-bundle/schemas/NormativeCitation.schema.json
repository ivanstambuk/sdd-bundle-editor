{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NormativeCitation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "bootstrapEntityId",
    "sourceEntityType"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^NCIT-[a-z0-9-]+$",
      "x-sdd-entityType": "NormativeCitation",
      "x-sdd-idTemplate": "NCIT-{slug}"
    },
    "title": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "sourceEntityType": {
      "type": "string"
    },
    "bootstrapEntityId": {
      "type": "string"
    },
    "bootstrapSectionIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "x-sdd-displayHint": "chips"
    },
    "bootstrapPublicationIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "x-sdd-displayHint": "chips"
    },
    "publicationTitles": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "x-sdd-displayHint": "chips"
    },
    "sectionTitles": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "x-sdd-displayHint": "chips"
    },
    "pageSpans": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "x-sdd-displayHint": "chips"
    },
    "sourcePdfPaths": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "x-sdd-displayHint": "chips"
    },
    "excerpt": {
      "type": "string",
      "x-sdd-displayHint": "markdown"
    },
    "sourceServiceIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "x-sdd-displayHint": "chips"
    },
    "notes": {
      "type": "string",
      "x-sdd-displayHint": "markdown"
    }
  }
}
