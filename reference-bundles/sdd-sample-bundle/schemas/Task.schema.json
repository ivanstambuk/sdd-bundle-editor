{
  "$id": "https://example.com/sdd/Task.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Task",
  "type": "object",
  "required": [
    "createdDate",
    "id",
    "lastModifiedBy",
    "lastModifiedDate",
    "title"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^TASK-[a-z0-9-]+$",
      "x-sdd-idTemplate": "TASK-{000}",
      "x-sdd-entityType": "Task",
      "x-sdd-idScope": "bundle",
      "description": "Unique identifier for this entity",
      "maxLength": 30,
      "x-sdd-layoutGroup": "overview",
      "x-sdd-displayHint": "hidden"
    },
    "title": {
      "type": "string",
      "minLength": 5,
      "description": "Short, descriptive name",
      "maxLength": 80,
      "x-sdd-layoutGroup": "overview",
      "x-sdd-order": 10
    },
    "description": {
      "type": "string",
      "description": "Detailed description of the task",
      "x-sdd-widget": "textarea",
      "x-sdd-displayHint": "markdown",
      "x-sdd-layoutGroup": "overview",
      "x-sdd-prominence": "secondary",
      "x-sdd-prominenceLabel": "Description",
      "x-sdd-prominenceIcon": "✅",
      "x-sdd-order": 30
    },
    "status": {
      "type": "string",
      "enum": [
        "planned",
        "in-progress",
        "done"
      ],
      "description": "Current lifecycle state",
      "x-sdd-enumTitles": {
        "planned": "Planned",
        "in-progress": "In Progress",
        "done": "Done"
      },
      "x-sdd-layoutGroup": "overview",
      "x-sdd-order": 20
    },
    "fulfillsRequirementIds": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "sdd-ref",
        "x-sdd-refTargets": [
          "Requirement"
        ]
      },
      "uniqueItems": true,
      "description": "Requirements this task fulfills",
      "title": "fulfills",
      "x-sdd-layoutGroup": "traceability",
      "x-sdd-order": 10
    },
    "belongsToFeatureIds": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "sdd-ref",
        "x-sdd-refTargets": [
          "Feature"
        ]
      },
      "uniqueItems": true,
      "description": "Features this task belongs to",
      "title": "belongs to",
      "x-sdd-layoutGroup": "traceability",
      "x-sdd-order": 20
    },
    "createdDate": {
      "type": "string",
      "format": "date-time",
      "title": "Created Date",
      "description": "Date when this entity was first created",
      "x-sdd-displayLocation": "header"
    },
    "lastModifiedDate": {
      "type": "string",
      "format": "date-time",
      "title": "Last Modified Date",
      "description": "Date of last modification",
      "x-sdd-displayLocation": "header"
    },
    "lastModifiedBy": {
      "type": "string",
      "title": "Modified By",
      "description": "User or team who last modified this entity",
      "x-sdd-displayLocation": "header"
    }
  },
  "additionalProperties": false,
  "x-sdd-ui": {
    "title": "Task",
    "icon": "✅",
    "displayNamePlural": "Tasks"
  },
  "description": "Actionable work item that implements features, fixes issues, or performs other development activities",
  "x-sdd-displayHint": "markdown",
  "x-sdd-meta": {
    "createdDate": "2024-01-01T00:00:00Z",
    "lastModifiedDate": "2024-12-19T00:00:00Z",
    "lastModifiedBy": "ACT-ivan"
  },
  "x-sdd-layoutGroups": {
    "overview": {
      "title": "Overview",
      "order": 1
    },
    "traceability": {
      "title": "Traceability",
      "order": 2
    }
  }
}
