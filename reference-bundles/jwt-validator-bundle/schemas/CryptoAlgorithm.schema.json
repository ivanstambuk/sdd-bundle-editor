{
  "$id": "sdd-bundle:jwt-validator:CryptoAlgorithm",
  "type": "object",
  "title": "CryptoAlgorithm",
  "required": [
    "id",
    "kind",
    "title",
    "executionStatus",
    "artifactClass",
    "lifecycleStatus"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^ALG-[a-zA-Z0-9]+$",
      "x-sdd-displayHint": "hidden",
      "x-sdd-layoutGroup": "overview"
    },
    "kind": {
      "type": "string",
      "const": "CryptoAlgorithm",
      "x-sdd-displayHint": "hidden",
      "x-sdd-layoutGroup": "overview"
    },
    "title": {
      "type": "string",
      "x-sdd-layoutGroup": "overview",
      "x-sdd-order": 10
    },
    "description": {
      "type": "string",
      "x-sdd-displayHint": "markdown",
      "x-sdd-layoutGroup": "overview",
      "x-sdd-prominence": "primary",
      "x-sdd-prominenceLabel": "Description",
      "x-sdd-prominenceIcon": "📝",
      "x-sdd-order": 20
    },
    "rationale": {
      "type": "string",
      "x-sdd-displayHint": "markdown",
      "x-sdd-layoutGroup": "overview",
      "x-sdd-prominence": "secondary",
      "x-sdd-prominenceLabel": "Rationale",
      "x-sdd-prominenceIcon": "🤔",
      "x-sdd-order": 30
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "x-sdd-displayHint": "chips",
      "x-sdd-layoutGroup": "overview",
      "x-sdd-order": 99
    },
    "executionStatus": {
      "type": "string",
      "title": "Execution Status",
      "description": "Whether this artifact is part of the active executable contract, advisory-only, or planned for later execution.",
      "enum": [
        "active",
        "advisory",
        "planned"
      ],
      "x-sdd-layoutGroup": "details",
      "x-sdd-order": 1
    },
    "artifactClass": {
      "type": "string",
      "title": "Artifact Class",
      "description": "Classifies whether this entity is part of the contract, a support artifact, fixture infrastructure, or documentation.",
      "enum": [
        "contract",
        "support",
        "fixture",
        "documentation"
      ],
      "x-sdd-layoutGroup": "details",
      "x-sdd-order": 2
    },
    "lifecycleStatus": {
      "type": "string",
      "title": "Lifecycle Status",
      "description": "Tracks whether this artifact is still draft, active, deprecated, or superseded.",
      "enum": [
        "draft",
        "active",
        "deprecated",
        "superseded"
      ],
      "x-sdd-layoutGroup": "details",
      "x-sdd-order": 3
    },
    "governedByAdrIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "x-sdd-refTargets": [
        "ADR"
      ],
      "x-sdd-layoutGroup": "traceability",
      "x-sdd-order": 10,
      "title": "Governed By Adr References",
      "description": "References related ADR entity."
    },
    "joseName": {
      "type": "string",
      "x-sdd-layoutGroup": "details",
      "x-sdd-order": 10
    },
    "keyFamily": {
      "type": "string",
      "enum": [
        "RSA",
        "EC",
        "OCT",
        "NONE"
      ],
      "x-sdd-layoutGroup": "details",
      "x-sdd-order": 20
    },
    "minKeySizeBits": {
      "type": "integer",
      "x-sdd-layoutGroup": "details",
      "x-sdd-order": 30
    },
    "isQuantumSafe": {
      "type": "boolean",
      "x-sdd-layoutGroup": "details",
      "x-sdd-order": 40
    },
    "strengthBits": {
      "type": "integer",
      "x-sdd-layoutGroup": "details",
      "x-sdd-order": 50
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "executionStatus": {
            "const": "active"
          },
          "artifactClass": {
            "const": "contract"
          }
        },
        "required": [
          "executionStatus",
          "artifactClass"
        ]
      },
      "then": {
        "properties": {
          "joseName": {},
          "keyFamily": {},
          "minKeySizeBits": {}
        },
        "required": [
          "joseName",
          "keyFamily",
          "minKeySizeBits"
        ]
      }
    }
  ],
  "x-sdd-ui": {
    "displayName": "Crypto Algorithm",
    "displayNamePlural": "Crypto Algorithms",
    "icon": "🧮"
  },
  "x-sdd-layoutGroups": {
    "overview": {
      "title": "Overview",
      "order": 1
    },
    "details": {
      "title": "Properties & Configuration",
      "order": 2
    },
    "traceability": {
      "title": "Relationships",
      "order": 3
    }
  }
}
